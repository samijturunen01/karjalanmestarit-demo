# Build-time options (all optional). Copy to .env.local for local overrides.

# Sub-path when hosted as a GitHub Pages project site, e.g. /karjalanmestarit-demo/
BASE_PATH=/

# Absolute site URL WITHOUT trailing slash. Enables canonical URLs, og:url,
# absolute og:image and sitemap.xml. Leave empty until the final domain is approved.
SITE_URL=

# true = allow search engines. Keep false for the speculative demo.
ALLOW_INDEXING=false

# Shows the small "Konseptidemo" notice. Set to false only for an approved production build.
VITE_DEMO_MODE=true

# Quote-request endpoint (e.g. a Google Apps Script web app URL). Empty = mock handler,
# nothing is sent or stored. Never put secrets here – VITE_* values end up in the bundle.
VITE_QUOTE_ENDPOINT=
